     <widget class="QWidget" name="sshTab">
      <attribute name="title">
       <string>SSH Tunnel</string>
      </attribute>
      <layout class="QVBoxLayout" name="sshLayout">
       <item>
        <widget class="QGroupBox" name="ssh">
         <property name="title">
          <string>Connect through an &amp;SSH tunnel</string>
         </property>
         <property name="checkable">
          <bool>true</bool>
         </property>
         <property name="checked">
          <bool>false</bool>
         </property>
         <layout class="QFormLayout" name="sshForm">
          <item row="0" column="0">
           <widget class="QLabel" name="sshHostLabel">
            <property name="text">
             <string>SSH &amp;host:</string>
            </property>
            <property name="buddy">
             <cstring>sshHost</cstring>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <layout class="QHBoxLayout" name="sshHostRow" stretch="1,0,0">
            <item>
             <widget class="QLineEdit" name="sshHost"/>
            </item>
            <item>
             <widget class="QLabel" name="sshPortLabel">
              <property name="text">
               <string>P&amp;ort:</string>
              </property>
              <property name="buddy">
               <cstring>sshPort</cstring>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="sshPort">
              <property name="minimum">
               <number>1</number>
              </property>
              <property name="maximum">
               <number>65535</number>
              </property>
              <property name="value">
               <number>22</number>
              </property>
             </widget>
            </item>
           </layout>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="sshUserLabel">
            <property name="text">
             <string>SSH &amp;user:</string>
            </property>
            <property name="buddy">
             <cstring>sshUser</cstring>
            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="sshUser">
            <property name="placeholderText">
             <string>Your login name</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="sshAuthLabel">
            <property name="text">
             <string>&amp;Authentication:</string>
            </property>
            <property name="buddy">
             <cstring>sshAuth</cstring>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="sshAuth">
            <property name="toolTip">
             <string>The order of the items must match config::SshTunnelSettings::Auth.</string>
            </property>
            <item>
             <property name="text">
              <string>SSH agent or default keys</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Private key file</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Password</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="sshKeyFileLabel">
            <property name="text">
             <string>&amp;Key file:</string>
            </property>
            <property name="buddy">
             <cstring>sshKeyFile</cstring>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QWidget" name="sshKeyField" native="true">
            <layout class="QHBoxLayout" name="sshKeyRow" stretch="1,0">
             <property name="leftMargin">
              <number>0</number>
             </property>
             <property name="topMargin">
              <number>0</number>
             </property>
             <property name="rightMargin">
              <number>0</number>
             </property>
             <property name="bottomMargin">
              <number>0</number>
             </property>
             <item>
              <widget class="QLineEdit" name="sshKeyFile"/>
             </item>
             <item>
              <widget class="QToolButton" name="sshKeyFileBrowse">
               <property name="toolTip">
                <string>Browse</string>
               </property>
               <property name="text">
                <string notr="true">…</string>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="sshSecretLabel">
            <property name="text">
             <string>Pass&amp;word:</string>
            </property>
            <property name="buddy">
             <cstring>sshSecret</cstring>
            </property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QLineEdit" name="sshSecret">
            <property name="echoMode">
             <enum>QLineEdit::EchoMode::Password</enum>
            </property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QCheckBox" name="sshSaveSecret">
            <property name="text">
             <string>Save the password</string>
            </property>
           </widget>
          </item>
          <item row="6" column="0" colspan="2">
           <widget class="QLabel" name="sshNote">
            <property name="enabled">
             <bool>false</bool>
            </property>
            <property name="text">
             <string>Uses the ssh program. The server's host key is accepted and remembered the first time; a changed key fails the connection.</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="sshSpacer">
         <property name="orientation">
          <enum>Qt::Orientation::Vertical</enum>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="advancedTab">
      <attribute name="title">
       <string>Advanced</string>
      </attribute>
      <layout class="QFormLayout" name="advancedForm">
       <item row="0" column="0">
        <widget class="QLabel" name="applicationNameLabel">
         <property name="text">
          <string>Application &amp;name:</string>
         </property>
         <property name="buddy">
          <cstring>applicationName</cstring>
         </property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="applicationName"/>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="connectTimeoutLabel">
         <property name="text">
          <string>Connect &amp;timeout:</string>
         </property>
         <property name="buddy">
          <cstring>connectTimeout</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="connectTimeout">
         <property name="specialValueText">
          <string>None</string>
         </property>
         <property name="suffix">
          <string> s</string>
         </property>
         <property name="maximum">
          <number>600</number>
         </property>
