         <item>
          <widget class="QPushButton" name="colorButton">
           <property name="text">
            <string>Choose…</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QToolButton" name="clearColorButton">
           <property name="toolTip">
            <string>No color</string>
           </property>
