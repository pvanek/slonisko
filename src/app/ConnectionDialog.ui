          <string>&amp;Host:</string>
         </property>
         <property name="buddy">
          <cstring>host</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <layout class="QHBoxLayout" name="hostRow" stretch="1,0,0">
         <item>
          <widget class="QLineEdit" name="host"/>
         </item>
         <item>
          <widget class="QLabel" name="portLabel">
           <property name="text">
            <string>&amp;Port:</string>
           </property>
           <property name="buddy">
            <cstring>port</cstring>
           </property>
          </widget>
         </item>
