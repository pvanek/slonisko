       <item row="4" column="0">
        <widget class="QLabel" name="userLabel">
         <property name="text">
          <string>&amp;User:</string>
         </property>
         <property name="buddy">
          <cstring>user</cstring>
         </property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QLineEdit" name="user"/>
