       <item row="5" column="0">
        <widget class="QLabel" name="passwordModeLabel">
         <property name="text">
          <string>Pass&amp;word:</string>
         </property>
         <property name="buddy">
          <cstring>passwordMode</cstring>
         </property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QComboBox" name="passwordMode">
         <property name="toolTip">
          <string>The order of the items must match config::PasswordMode.</string>
         </property>
         <item>
          <property name="text">
           <string>Save password</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>Ask on every connect</string>
          </property>
         </item>
         <item>
          <property name="text">
           <string>No password (.pgpass, trust, peer, …)</string>
          </property>
         </item>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QLineEdit" name="password">
         <property name="echoMode">
          <enum>QLineEdit::EchoMode::Password</enum>
         </property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QLabel" name="walletWarning">
         <property name="styleSheet">
          <string notr="true">color: #b26a00;</string>
         </property>
         <property name="text">
          <string>No system wallet is available: saved passwords are stored in plain text in the settings file.</string>
         </property>
