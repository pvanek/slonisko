       <item row="1" column="0">
        <widget class="QLabel" name="colorLabel">
         <property name="text">
          <string>&amp;Color:</string>
         </property>
         <property name="buddy">
          <cstring>colorButton</cstring>
         </property>
        </widget>
       </item>
       <item row="1" column="1">
