       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="extraParametersLabel">
         <property name="text">
          <string>&amp;Extra parameters:</string>
         </property>
         <property name="buddy">
          <cstring>extraParameters</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QLineEdit" name="extraParameters">
         <property name="toolTip">
          <string>Further libpq connection parameters, as keyword=value pairs separated by spaces</string>
         </property>
         <property name="placeholderText">
          <string notr="true">target_session_attrs=read-write keepalives_idle=60</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status">
     <property name="wordWrap">
