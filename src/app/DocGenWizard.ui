        <property name="text">
         <string>&amp;All</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="noSchemas">
        <property name="text">
         <string>&amp;None</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="schemasStatus">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Preferred">
          <horstretch>0</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="alignment">
         <set>Qt::AlignRight|Qt::AlignVCenter</set>
        </property>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="slonisko::DocGenPage" name="outputPage">
   <property name="title">
    <string>Format and Folder</string>
   </property>
   <property name="subTitle">
    <string>What to write, and where to.</string>
   </property>
   <layout class="QFormLayout" name="outputLayout">
    <item row="0" column="0">
     <widget class="QLabel" name="formatLabel">
      <property name="text">
       <string>&amp;Format:</string>
      </property>
      <property name="buddy">
       <cstring>format</cstring>
      </property>
     </widget>
    </item>
    <item row="0" column="1">
     <widget class="QComboBox" name="format"/>
    </item>
    <item row="1" column="0">
     <widget class="QLabel" name="outputLabel">
      <property name="text">
       <string>F&amp;older:</string>
      </property>
      <property name="buddy">
       <cstring>output</cstring>
      </property>
     </widget>
    </item>
    <item row="1" column="1">
     <layout class="QHBoxLayout" name="folderLayout">
      <item>
