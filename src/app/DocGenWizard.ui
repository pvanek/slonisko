       <item row="0" column="1">
        <widget class="QCheckBox" name="notices">
         <property name="toolTip">
          <string>Findings only worth knowing, beside warnings and critical ones</string>
         </property>
         <property name="text">
          <string>&amp;Notices</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
