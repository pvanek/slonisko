      <property name="text">
       <string>schema</string>
      </property>
     </widget>
    </item>
    <item row="3" column="0" colspan="2">
     <widget class="QCheckBox" name="openWhenDone">
      <property name="text">
       <string>&amp;Open when finished</string>
      </property>
      <property name="checked">
       <bool>true</bool>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="slonisko::DocGenPage" name="contentsPage">
   <property name="title">
