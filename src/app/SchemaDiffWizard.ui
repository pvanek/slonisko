      <item>
       <spacer name="scriptSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="openInEditor">
        <property name="text">
