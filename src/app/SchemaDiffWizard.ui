    </item>
   </layout>
  </widget>
  <widget class="slonisko::DocGenPage" name="resultPage">
   <property name="title">
    <string>Differences</string>
   </property>
   <property name="subTitle">
    <string>What differs, and the script that makes Target like Reference. Read it before running it.</string>
   </property>
   <layout class="QVBoxLayout" name="resultLayout">
    <item>
     <widget class="slonisko::CalloutLabel" name="status">
      <property name="wordWrap">
       <bool>true</bool>
      </property>
