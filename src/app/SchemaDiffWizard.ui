  </property>
  <widget class="slonisko::DocGenPage" name="connectionsPage">
   <property name="title">
    <string>Databases</string>
   </property>
   <property name="subTitle">
    <string>Reference is the schema to match, and is only read. The script runs on Target, and makes it like Reference.</string>
   </property>
   <layout class="QVBoxLayout" name="connectionsLayout">
    <item>
     <layout class="QGridLayout" name="connectionsGrid">
      <item row="0" column="1">
       <widget class="QLabel" name="connectionHeader">
        <property name="text">
         <string>Connection</string>
        </property>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel" name="databaseHeader">
        <property name="text">
         <string>Database</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="referenceLabel">
        <property name="text">
         <string>&amp;Reference:</string>
        </property>
        <property name="buddy">
         <cstring>referenceProfile</cstring>
        </property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="referenceProfile">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
       </widget>
      </item>
      <item row="1" column="2">
       <widget class="QComboBox" name="referenceDatabase">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="editable">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="1" column="3">
       <widget class="QLabel" name="referenceState"/>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="targetLabel">
        <property name="text">
         <string>&amp;Target:</string>
        </property>
        <property name="buddy">
         <cstring>targetProfile</cstring>
        </property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QComboBox" name="targetProfile">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
       </widget>
      </item>
      <item row="2" column="2">
       <widget class="QComboBox" name="targetDatabase">
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
         </sizepolicy>
        </property>
        <property name="editable">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item row="2" column="3">
       <widget class="QLabel" name="targetState"/>
      </item>
     </layout>
    </item>
    <item>
     <widget class="slonisko::CalloutLabel" name="connectionsStatus">
      <property name="wordWrap">
       <bool>true</bool>
      </property>
     </widget>
    </item>
    <item>
     <spacer name="connectionsSpacer">
      <property name="orientation">
       <enum>Qt::Vertical</enum>
      </property>
     </spacer>
    </item>
   </layout>
  </widget>
  <widget class="slonisko::DocGenPage" name="schemasPage">
   <property name="title">
    <string>Schemas</string>
   </property>
   <property name="subTitle">
    <string>Which schemas to compare, of either database.</string>
   </property>
   <layout class="QVBoxLayout" name="schemasLayout">
    <item>
     <widget class="QListWidget" name="schemas"/>
