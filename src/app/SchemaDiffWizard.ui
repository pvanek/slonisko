       </widget>
      </item>
      <item>
       <widget class="QCheckBox" name="concurrentIndexes">
        <property name="text">
         <string>Build indexes &amp;concurrently</string>
        </property>
        <property name="toolTip">
         <string>CREATE INDEX CONCURRENTLY on existing tables lets writes go on, but cannot run in a transaction</string>
